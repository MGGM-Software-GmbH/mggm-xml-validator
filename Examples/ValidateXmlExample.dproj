<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{87DD2BBE-E72A-4D6C-B3CE-BF03946070B6}</ProjectGuid>
    <MainSource>ValidateXmlExample.dpr</MainSource>
    <ProjectName>ValidateXmlExample</ProjectName>
    <ProjectVersion>19.0</ProjectVersion>
    <FrameworkType>None</FrameworkType>
    <AppType>Console</AppType>
    <Base>true</Base>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <TargetedPlatforms>2</TargetedPlatforms>
    <DCC_Namespace>System;Xml;Winapi;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\Source</DCC_UnitSearchPath>
    <PRODUCTVERSION Condition="'$(PRODUCTVERSION)'==''">$([System.IO.Path]::GetFileName($([System.String]::Copy('$(BDS)').TrimEnd('\'))))</PRODUCTVERSION>
    <CompilerOutputSuffix>\BDS$(PRODUCTVERSION)</CompilerOutputSuffix>
    <CompilerOutputSuffix Condition="'$(PRODUCTVERSION)'=='22.0'"></CompilerOutputSuffix>
    <CompilerOutputSuffix Condition="'$(PRODUCTVERSION)'=='23.0'">\Delphi12</CompilerOutputSuffix>
    <CompilerOutputSuffix Condition="'$(PRODUCTVERSION)'=='37.0'">\Delphi13</CompilerOutputSuffix>
    <DCC_ExeOutput>..\build$(CompilerOutputSuffix)</DCC_ExeOutput>
    <DCC_DcuOutput>..\build\obj\$(PRODUCTVERSION)\$(Platform)\$(Config)\$(ProjectName)</DCC_DcuOutput>
    <DCC_DebugInformation>0</DCC_DebugInformation>
  </PropertyGroup>
  <ItemGroup><DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile></ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>
